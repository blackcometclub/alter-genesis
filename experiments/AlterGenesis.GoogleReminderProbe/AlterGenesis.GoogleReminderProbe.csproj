<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AlterGenesis.GoogleReminderProbe</AssemblyName>
    <Product>ALTER GENESIS OAuth Reminder Read-only Probe</Product>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ProbeClientFile>$(MSBuildThisFileDirectory)..\..\artifacts\oauth-reminder-build\client.json</ProbeClientFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.77.0.4285" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <EmbeddedResource Include="$(ProbeClientFile)" LogicalName="AlterGenesis.GoogleReminderProbe.Client"
                      Condition="Exists('$(ProbeClientFile)')" />
  </ItemGroup>
</Project>
