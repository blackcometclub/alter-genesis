<Window x:Class="AlterGenesis.NotificationProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ALTER GENESIS — Notification Probe"
        Width="{DynamicResource Card.Width}"
        SizeToContent="Height"
        MaxHeight="{DynamicResource Card.MaxWindowHeight}"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        AllowsTransparency="False"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="Segoe UI Variable Text, Yu Gothic UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.ContextMenu>
        <ContextMenu Style="{StaticResource Style.SettingsContextMenu}">
            <MenuItem Header="{DynamicResource Text.Settings}" Click="OpenSettingsClick" />
        </ContextMenu>
    </Window.ContextMenu>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Brush.Surface}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="16">
        <ScrollViewer MaxHeight="{DynamicResource Card.ViewportHeight}"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <ItemsControl ItemsSource="{Binding Notifications}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Brush.Divider}"
                                BorderThickness="0,0,0,1">
                            <Grid MinHeight="{DynamicResource Card.RowHeight}"
                                  automation:AutomationProperties.AutomationId="NotificationItem"
                                  automation:AutomationProperties.Name="{Binding Title}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Background="{Binding CalendarBrush}"
                                        automation:AutomationProperties.AutomationId="CalendarBand" />

                                <Grid Grid.Column="1" Margin="{DynamicResource Card.ContentPadding}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="{DynamicResource Card.RowGap}" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" MinHeight="{DynamicResource Card.HeadingHeight}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="84" />
                                            <ColumnDefinition Width="{DynamicResource Card.TitleGap}" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding StartTime}"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   FontFamily="Segoe UI Variable Display, Segoe UI"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"
                                                   Typography.NumeralStyle="Lining"
                                                   automation:AutomationProperties.AutomationId="EventStartTime" />

                                        <Button Grid.Column="2"
                                                Tag="{Binding}"
                                                Click="OpenCalendarClick"
                                                Style="{DynamicResource Style.TitleButton}"
                                                ToolTipService.InitialShowDelay="350"
                                                ToolTipService.ShowDuration="30000"
                                                automation:AutomationProperties.Name="{Binding Title}"
                                                automation:AutomationProperties.HelpText="{DynamicResource Text.OpenCalendar}">
                                            <Button.ToolTip>
                                                <ToolTip Content="{Binding PlacementTarget.DataContext.Title, RelativeSource={RelativeSource Self}}"
                                                         Style="{DynamicResource Style.TitleToolTip}" />
                                            </Button.ToolTip>
                                            <Grid HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       Tag="{Binding RelativeSource={RelativeSource AncestorType=Button}}"
                                                       Loaded="TitleTextLoaded"
                                                       SizeChanged="TitleTextSizeChanged"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       FontSize="26"
                                                       FontWeight="Medium"
                                                       automation:AutomationProperties.AutomationId="EventTitle" />
                                                <Path Grid.Column="1" Width="14"
                                                              Height="14"
                                                              Margin="8,0,0,0"
                                                              VerticalAlignment="Center"
                                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                              StrokeThickness="1.5"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              Data="M 2,5 L 2,12 L 9,12 M 6,2 L 12,2 L 12,8 M 12,2 L 5,9" />
                                            </Grid>
                                        </Button>
                                    </Grid>

                                    <StackPanel Grid.Row="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right">
                                        <ComboBox Width="116"
                                                  Margin="0,0,8,0"
                                                  SelectedIndex="0"
                                                  Tag="{Binding}"
                                                  SelectionChanged="SnoozeSelectionChanged"
                                                  Style="{DynamicResource Style.CompactComboBox}"
                                                  automation:AutomationProperties.AutomationId="SnoozeNotification"
                                                  automation:AutomationProperties.Name="{DynamicResource Text.SnoozeAccessibleName}">
                                            <ComboBoxItem Content="{DynamicResource Text.Snooze}" />
                                            <ComboBoxItem Content="{DynamicResource Text.Snooze5Minutes}" Tag="5" />
                                            <ComboBoxItem Content="{DynamicResource Text.Snooze10Minutes}" Tag="10" />
                                            <ComboBoxItem Content="{DynamicResource Text.Snooze30Minutes}" Tag="30" />
                                            <ComboBoxItem Content="{DynamicResource Text.Snooze1Hour}" Tag="60" />
                                            <ComboBoxItem Content="{DynamicResource Text.SnoozeAtTime}" Tag="custom" IsEnabled="False" />
                                        </ComboBox>

                                        <Button MinWidth="72"
                                                Tag="{Binding}"
                                                Click="CloseNotificationClick"
                                                Content="{DynamicResource Text.Close}"
                                                Style="{DynamicResource Style.CloseButton}"
                                                automation:AutomationProperties.AutomationId="CloseNotification" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Border>
</Window>
