<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AlterGenesis.NotificationProbe</AssemblyName>
    <RootNamespace>AlterGenesis.NotificationProbe</RootNamespace>
    <Product>ALTER GENESIS Notification Probe</Product>
    <Description>Isolated WPF probe for persistent Google Calendar notifications.</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <GoogleClientFile Condition="'$(GoogleClientFile)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\oauth-reminder-build\client.json</GoogleClientFile>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <PackageReference Include="Ical.Net" Version="5.2.3" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.77.0.4285" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <EmbeddedResource Include="$(GoogleClientFile)" LogicalName="AlterGenesis.Google.Client" Condition="Exists('$(GoogleClientFile)')" />
    <Compile Include="..\..\experiments\AlterGenesis.GoogleReminderProbe\ReminderCalculation.cs" Link="Google\ReminderCalculation.cs" />
    <EmbeddedResource Include="..\..\audio\candidates\2026-10-28\01-koron.wav" LogicalName="AlterGenesis.Sounds.Koron.wav" />
    <EmbeddedResource Include="..\..\audio\candidates\2026-10-28\02-kirari.wav" LogicalName="AlterGenesis.Sounds.Kirari.wav" />
    <EmbeddedResource Include="..\..\audio\candidates\2026-10-28\03-pikon.wav" LogicalName="AlterGenesis.Sounds.Pikon.wav" />
  </ItemGroup>
</Project>
