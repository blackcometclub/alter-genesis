<Window x:Class="AlterGenesis.NotificationProbe.AddIcalCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Text.AddCalendarTitle}"
        Width="408" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Segoe UI Variable Text, Yu Gothic UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid x:Name="UrlStep">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Text.IcalUrl}" FontSize="14" />
            <PasswordBox Grid.Row="2" x:Name="SecretUrlBox"
                         Style="{StaticResource Style.CompactPasswordBox}"
                         PasswordChanged="SecretUrlChanged"
                         AutomationProperties.AutomationId="IcalUrl"
                         AutomationProperties.Name="{DynamicResource Text.IcalUrl}" />
            <TextBlock Grid.Row="3" x:Name="UrlErrorText" Margin="0,8,0,0"
                       FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Assertive" />
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="{DynamicResource Text.Cancel}" Click="CancelClick"
                        Style="{StaticResource Style.SecondaryButton}" IsCancel="True" />
                <Button x:Name="ConnectButton" Margin="8,0,0,0"
                        Content="{DynamicResource Text.Connect}" Click="ConnectClick"
                        Style="{StaticResource Style.CloseButton}"
                        AutomationProperties.AutomationId="ConnectCalendar" />
            </StackPanel>
        </Grid>

        <Grid x:Name="DetailsStep" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Text.CalendarName}" FontSize="14" />
            <TextBox Grid.Row="2" x:Name="CalendarNameBox"
                     Style="{StaticResource Style.CompactTextBox}"
                     TextChanged="CalendarNameChanged"
                     MaxLength="200"
                     AutomationProperties.AutomationId="CalendarName"
                     AutomationProperties.Name="{DynamicResource Text.CalendarName}" />
            <TextBlock Grid.Row="3" x:Name="DetailsErrorText" Margin="0,8,0,0"
                       FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       AutomationProperties.LiveSetting="Assertive" />
            <TextBlock Grid.Row="5" Text="{DynamicResource Text.CalendarColor}" FontSize="14" />
            <ListBox Grid.Row="7" x:Name="ColorChoice" Height="32"
                     ItemsSource="{Binding ColorOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                     SelectionMode="Single" SelectedIndex="0"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     AutomationProperties.AutomationId="CalendarColor">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Margin" Value="0,0,8,0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="2" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource Style.ControlFocusVisual}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="SelectionBorder" CornerRadius="6"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <Border Margin="4" CornerRadius="3" Background="{Binding Brush}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="SelectionBorder" Property="Background" Value="{DynamicResource Brush.SurfaceHover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="{DynamicResource Text.Back}" Click="BackClick"
                        Style="{StaticResource Style.SecondaryButton}" />
                <Button x:Name="SaveButton" Margin="8,0,0,0" Content="{DynamicResource Text.AddCalendar}" Click="AddClick"
                        Style="{StaticResource Style.CloseButton}"
                        AutomationProperties.AutomationId="SaveCalendar" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
