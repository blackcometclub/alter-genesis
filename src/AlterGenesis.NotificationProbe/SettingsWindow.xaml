<Window x:Class="AlterGenesis.NotificationProbe.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:effects="clr-namespace:AlterGenesis.NotificationProbe.Effects"
        xmlns:models="clr-namespace:AlterGenesis.NotificationProbe.Models"
        Title="{DynamicResource Text.SettingsTitle}"
        Width="408" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        FontFamily="Segoe UI Variable Text, Yu Gothic UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{DynamicResource Text.CardSize}" FontSize="14" />
        <ComboBox Grid.Row="2" x:Name="CardSizeChoice"
                  Width="{Binding ActualWidth, ElementName=SoundChoice}" HorizontalAlignment="Left"
                  Style="{StaticResource Style.CompactComboBox}"
                  SelectedValuePath="Tag" SelectionChanged="CardSizeSelectionChanged"
                  AutomationProperties.AutomationId="CardSizeChoice"
                  AutomationProperties.Name="{DynamicResource Text.CardSize}">
            <ComboBoxItem Content="{DynamicResource Text.CardSizeSmall}" Tag="{x:Static models:NotificationCardSize.Small}" />
            <ComboBoxItem Content="{DynamicResource Text.CardSizeLarge}" Tag="{x:Static models:NotificationCardSize.Large}" />
        </ComboBox>
        <TextBlock Grid.Row="4" Text="{DynamicResource Text.NotificationSound}" FontSize="14" />
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="SoundChoice" Style="{StaticResource Style.CompactComboBox}"
                      SelectedValuePath="Tag" SelectionChanged="SoundSelectionChanged"
                      AutomationProperties.AutomationId="NotificationSoundChoice"
                      AutomationProperties.Name="{DynamicResource Text.NotificationSound}">
                <ComboBoxItem Content="{DynamicResource Text.SoundNone}" Tag="{x:Static effects:NotificationSound.None}" />
                <ComboBoxItem Content="{DynamicResource Text.SoundKoron}" Tag="{x:Static effects:NotificationSound.Koron}" />
                <ComboBoxItem Content="{DynamicResource Text.SoundKirari}" Tag="{x:Static effects:NotificationSound.Kirari}" />
                <ComboBoxItem Content="{DynamicResource Text.SoundPikon}" Tag="{x:Static effects:NotificationSound.Pikon}" />
            </ComboBox>
            <Button Grid.Column="2" x:Name="PreviewButton"
                    Content="{DynamicResource Text.PreviewSound}" Click="PreviewSoundClick"
                    Style="{StaticResource Style.CloseButton}"
                    AutomationProperties.AutomationId="PreviewSound" />
        </Grid>
        <Button Grid.Row="8" x:Name="TestNotificationButton" HorizontalAlignment="Right"
                Content="{DynamicResource Text.TestNotification}" Click="TestNotificationClick"
                Style="{StaticResource Style.CloseButton}"
                AutomationProperties.AutomationId="TestNotification" />
    </Grid>
</Window>
